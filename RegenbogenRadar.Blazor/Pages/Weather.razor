@page "/weather"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using System.Text.Json
@using RegenbogenRadar.Domain
@inject HttpClient Http

<PageTitle>Wetter</PageTitle>

<div id="search-header">
    <h1>Wetter</h1>
    <div>
        <input id="search" type="search"
            @bind="query"
            @bind:event="oninput"
            @onkeydown="OnKeyDown" />
        <button class="btn-slim" @onclick="SearchAsync">Suchen</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(locationLabel))
{
    <p><strong>Ort:</strong> @locationLabel</p>
}

@if (isAiLoading)
{
    <p><em>Aktivitätsvorschlag wird erstellt...</em></p>
}
else if (!string.IsNullOrEmpty(aiRecommendation))
{
    <div class="ai-recommendation">
        <h3>Vorschlag</h3>
        <p>@aiRecommendation</p>
    </div>
}

@if (isLoading)
{
    <p><em>Wetterdaten laden...</em></p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <p style="color:#c00; white-space:pre-wrap">@error</p>
}
else
{
    @if ((dailyForecasts is null || dailyForecasts.Length == 0) &&
        (hourlyForecasts is null || hourlyForecasts.Length == 0))
    {
        <p>Bitte Ort suchen.</p>
    }

    @if (dailyForecasts?.Length > 0)
    {
        <h2>7-Tage-Aussicht</h2>
        <table class="table wx">
            <colgroup>
                <col class="col-date" />
                <col class="col-temp" />
                <col class="col-summary" />
            </colgroup>
            <thead>
                <tr>
                    <th>Datum</th>
                    <th aria-label="Temperatur in Celsius">Temp. (C)</th>
                    <th>Wetterlage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in dailyForecasts)
                {
                    <tr>
                        <td>@f.Date.ToString("dd.MM.yyyy")</td>
                        <td>@($"{f.TemperatureC}°C")</td>
                        <td>@f.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (hourlyForecasts?.Length > 0)
    {
        <!-- Hinweis: Bei Zeitumstellung kann es 23 bzw. 25 Zeilen geben. -->
        <h2>Heute – stündlich</h2>
        <table class="table wx">
            <colgroup>
                <col class="col-date" />
                <col class="col-temp" />
                <col class="col-summary" />
            </colgroup>
            <thead>
                <tr>
                    <th>Uhrzeit</th>
                    <th aria-label="Temperatur in Celsius">Temp. (C)</th>
                    <th>Wetterlage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in hourlyForecasts)
                {
                    <tr>
                        <td>@h.Time.ToString("HH:mm")</td>
                        <td>@($"{h.TemperatureC}°C")</td>
                        <td>@h.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code
{
    private bool isLoading;
    private string? error;
    private string? locationLabel;
    private string query = string.Empty;
    private DailyForecast[]? dailyForecasts;
    private HourlyForecast[]? hourlyForecasts;
    private string? aiRecommendation;
    private bool isAiLoading;
    private CancellationTokenSource? aiCts;
    private CancellationTokenSource? cts;

    private static readonly JsonSerializerOptions jsonOptions = new (JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };

    // ENTER-Taste abfangen
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        // Vorherigen Request abbrechen
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        cts.CancelAfter(TimeSpan.FromSeconds(90)); // Timeout gegen Hänger
        var ct = cts.Token;

        error = null;
        locationLabel = null;
        dailyForecasts = null;
        hourlyForecasts = null;

        var q = query?.Trim();
        if (string.IsNullOrWhiteSpace(q))
        {
            error = "Bitte einen Ort eingeben.";
            return;
        }

        isLoading = true;
        try
        {
            // ---------- 1) Geocoding ----------
            var geoUrl = $"https://geocoding-api.open-meteo.com/v1/search?name={Uri.EscapeDataString(q)}&count=1&language=de&format=json";

            var (geoOk, geoBody, geoStatus) = await GetBodyAsync(geoUrl, ct);
            if (!geoOk)
                throw new HttpRequestException($"Geocoding fehlgeschlagen ({geoStatus}).\n{geoBody}");

            // var geo = await Http.GetFromJsonAsync<GeocodingResponse>(geoUrl);
            var geo = JsonSerializer.Deserialize<GeocodingResponse>(geoBody, jsonOptions);
            if (geo?.results is null || geo.results.Count == 0)
            {
                error = $"Kein Treffer für „{q}“.";
                return;
            }

            var place = geo.results[0];
            locationLabel = string.IsNullOrWhiteSpace(place.country)
                ? place.name
                : $"{place.name} ({place.country})";

            var lat = place.latitude.ToString(CultureInfo.InvariantCulture);
            var lon = place.longitude.ToString(CultureInfo.InvariantCulture);

            // ---------- 2) Forecast (daily + hourly) ----------
            // timezone=auto: Zeitangaben sind bereits in der Orts-Zeitzone inkl. DST
            var forecastUrl =
                $"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}" +
                $"&daily=temperature_2m_max,weathercode" +
                $"&hourly=temperature_2m,weathercode" +
                $"&timezone=auto&language=de&forecast_days=7";

            var (fcOk, fcBody, fcStatus) = await GetBodyAsync(forecastUrl, ct);
            if (!fcOk)
                throw new HttpRequestException($"Vorhersage fehlgeschlagen ({fcStatus}).\n{fcBody}");

            // var data = await Http.GetFromJsonAsync<ForecastResponse>(forecastUrl);
            var data = JsonSerializer.Deserialize<ForecastResponse>(fcBody, jsonOptions);
            if (data is null)
            {
                error = "Unerwartete Antwort der Wetter-API.";
                return;
            }

            // ---------- 3a) Daily mappen ----------
            if (data?.daily?.time is null || data.daily.time.Length == 0 ||
                data.daily.temperature_2m_max is null || data.daily.weathercode is null)
            {
                error = "Konnte keine tägliche Vorhersage laden (unvollständige Daten).";
                return;
            }

            var n = new[] { data.daily.time.Length, data.daily.temperature_2m_max.Length, data.daily.weathercode.Length }.Min();
            var days = new List<DailyForecast>(n);
            for (int i = 0; i < n; i++)
            {
                var date = DateTimeOffset.Parse(data.daily.time[i], CultureInfo.InvariantCulture).DateTime;
                days.Add(new DailyForecast
                {
                    Date = date,
                    TemperatureC = (int)Math.Round(data.daily.temperature_2m_max[i]),
                    Summary = WeatherFromCode(data.daily.weathercode[i])
                });
            }

            dailyForecasts = days.ToArray();

            // ---------- 3b) Hourly mappen – nur HEUTE (gemäß API-Zone) ----------
            if (data?.hourly?.time is null || data.hourly.time.Length == 0 ||
                data.hourly.temperature_2m is null || data.hourly.weathercode is null)
            {
                error = "Konnte keine stündliche Vorhersage laden.";
                return;
            }

            // "Heute" aus daily[0] ableiten -> konsistent zur API-Zeitzone
            var todayDate = DateOnly.FromDateTime(
                DateTimeOffset.Parse(data.daily.time[0], CultureInfo.InvariantCulture).DateTime);


            var m = new[] { data.hourly.time.Length, data.hourly.temperature_2m.Length, data.hourly.weathercode.Length }.Min();
            var hours = new List<HourlyForecast>(24);

            for (int i = 0; i < m; i++)
            {
                var ts = DateTimeOffset.Parse(data.hourly.time[i], CultureInfo.InvariantCulture).DateTime;
                if (DateOnly.FromDateTime(ts) == todayDate)
                {
                    hours.Add(new HourlyForecast
                    {
                        Time = ts,
                        TemperatureC = (int)Math.Round(data.hourly.temperature_2m[i]),
                        Summary = WeatherFromCode(data.hourly.weathercode[i])
                    });
                }
            }
            
            hourlyForecasts = hours.OrderBy(x => x.Time).ToArray();

            isLoading = false;
            StateHasChanged();

            // ---------- 4) OpenAI API Call ----------
            aiCts?.Cancel();
            aiCts?.Dispose();
            aiCts = new CancellationTokenSource(TimeSpan.FromSeconds(90));
            var payload = new WeatherPayload
            {
                Location = locationLabel,
                TimeIso = DateTimeOffset.Now.ToString("o"),
                Hourly = hourlyForecasts.Select(h => new HourlyBrief {
                    Time = h.Time.ToString("HH:mm"),
                    TempC = h.TemperatureC,
                    Summary = h.Summary }
                ).ToArray()
            };

            await FetchRecommendationAsync(payload, aiCts.Token);
        }
        catch (OperationCanceledException)
        {
            // ignorieren – ein neuer Request hat den alten abgebrochen
        }
        catch (HttpRequestException ex)
        {
            error = $"Netzwerkfehler: {ex.Message}";
        }
        catch (JsonException ex)
        {
            error = $"Antwort konnte nicht gelesen werden: {ex.Message}";
        }
        catch (Exception ex)
        {
            error = $"Unerwarteter Fehler: {ex.Message}";
        }
    }

    // Robust: Body + Status holen, Fehlertext anzeigen können
    private async Task<(bool ok, string body, int status)> GetBodyAsync(string url, CancellationToken ct)
    {
        using var resp = await Http.GetAsync(url, ct);
        var body = await resp.Content.ReadAsStringAsync(ct);
        return (resp.IsSuccessStatusCode, body, (int)resp.StatusCode);
    }

    // TEXT/BESCHREIBUNG FEHLT HIER NOCH!
    private async Task FetchRecommendationAsync(object payload, CancellationToken ct)
    {
        try
        {
            isAiLoading = true;
            aiRecommendation = null;

            var response = await Http.PostAsJsonAsync("https://localhost:7219/api/recommendation", payload, ct);
            if (!response.IsSuccessStatusCode)
            {
                var err = await response.Content.ReadAsStringAsync(ct);
                aiRecommendation = $"AI-Fehler {(int)response.StatusCode}: {response.ReasonPhrase}\n{err}";
                return;
            }

            var json = await response.Content.ReadFromJsonAsync<JsonElement>(cancellationToken: ct);
            aiRecommendation = json.GetProperty("response").GetString();
        }
        catch (OperationCanceledException) { /* ignoriere */ }
        catch (Exception ex)
        {
            aiRecommendation = $"AI-Fehler: {ex.Message}";
        }
        finally
        {
            isAiLoading = false;
            StateHasChanged();
        }
    }

    // ViewModels
    public class DailyForecast
    {
        public DateTime Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
    }

    public class HourlyForecast
    {
        public DateTime Time { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
    }

    // DTOs der Open-Meteo API
    public class GeocodingResponse
    {
        public List<GeoResult>? results { get; set; }
    }

    public class GeoResult
    {
        public string name { get; set; } = "";
        public double latitude { get; set; }
        public double longitude { get; set; }
        public string? country { get; set; }
    }

    public class ForecastResponse
    {
        public Daily? daily { get; set; }
        public Hourly? hourly { get; set; }
    }

    public class Daily
    {
        public string[] time { get; set; } = Array.Empty<string>();
        public double[] temperature_2m_max { get; set; } = Array.Empty<double>();
        public int[] weathercode { get; set; } = Array.Empty<int>();
    }

    public class Hourly
    {
        public string[] time { get; set; } = Array.Empty<string>();
        public double[] temperature_2m { get; set; } = Array.Empty<double>();
        public int[] weathercode { get; set; } = Array.Empty<int>();
    }

    // WMO-Code-Übersetzung (kurz)
    private static string WeatherFromCode(int code) => code switch
    {
        0               => "Klar",
        1 or 2          => "Überwiegend klar / teils bewölkt",
        3               => "Bedeckt",
        45 or 48        => "Nebel",
        51 or 53 or 55  => "Nieselregen",
        61 or 63 or 65  => "Regen",
        71 or 73 or 75  => "Schnee",
        80 or 81 or 82  => "Regenschauer",
        95              => "Gewitter",
        96 or 99        => "Gewitter mit Hagel",
        _               => "Unbekannt"
    };
}
