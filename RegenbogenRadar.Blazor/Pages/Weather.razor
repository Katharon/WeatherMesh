@page "/weather"
@using RegenbogenRadar.Blazor.Services
@using RegenbogenRadar.Shared.AiRecommendation
@using RegenbogenRadar.Shared.Geocoding
@using RegenbogenRadar.Shared.WeatherForecast
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BackendService BackendService

<PageTitle>Wetter</PageTitle>

<div id="search-header">
    <h1>Wetter</h1>
    <div>
        <input id="search" type="search" @bind="query" @onkeydown="OnKeyDown" />
        <button class="btn-slim" @onclick="SearchAsync">Suchen</button>
    </div>
</div>

<AuthorizeView>
    <Authorized>
        @if (this.isAiLoading)
        {
            <p><em>Aktivitätsvorschlag wird generiert...</em></p>
        }
        else if (this.recommendationDto != null)
        {
            <h3>Vorschlag:</h3>
            <p class="ai-recommendation">@this.recommendationDto.Recommendation</p>
        }
    </Authorized>
    <NotAuthorized>
        <p class="ai-recommendation">Gönne dir heute noch Premium!</p>
    </NotAuthorized>
</AuthorizeView>

@if (!string.IsNullOrWhiteSpace(location))
{
    <p><strong>Ort:</strong> @location</p>
}
@if (!string.IsNullOrWhiteSpace(error))
{
    <p class="error">@this.error</p>
}

@if (this.isWeatherLoading)
{
    <p><em>Wetterdaten werden geladen...</em></p>
}
else if (this.forecastDto != null)
{
    @if ((this.forecastDto.Daily is null || this.forecastDto.Daily.Length == 0) &&
        (this.forecastDto.Hourly is null || this.forecastDto.Hourly.Length == 0))
    {
        <p>Bitte Ort suchen.</p>
    }

    @if (this.forecastDto.Daily?.Length > 0)
    {
        <h2>7-Tage-Aussicht</h2>
        <table class="table wx">
            <colgroup>
                <col class="col-date" />
                <col class="col-temp" />
                <col class="col-summary" />
            </colgroup>
            <thead>
                <tr>
                    <th>Datum</th>
                    <th aria-label="Temperatur in Celsius">Temp. (C)</th>
                    <th>Wetterlage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in this.forecastDto.Daily)
                {
                    <tr>
                        <td>@f.Date.ToString("dd.MM.yyyy")</td>
                        <td>@($"{f.TemperatureC}°C")</td>
                        <td>@f.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (this.forecastDto.Hourly?.Length > 0)
    {
        <!-- Hinweis: Bei Zeitumstellung kann es 23 bzw. 25 Zeilen geben. -->
        <h2>Heute – stündlich</h2>
        <table class="table wx">
            <colgroup>
                <col class="col-date" />
                <col class="col-temp" />
                <col class="col-summary" />
            </colgroup>
            <thead>
                <tr>
                    <th>Uhrzeit</th>
                    <th aria-label="Temperatur in Celsius">Temp. (C)</th>
                    <th>Wetterlage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in this.forecastDto.Hourly)
                {
                    <tr>
                        <td>@h.Time.ToString("HH:mm")</td>
                        <td>@($"{h.TemperatureC}°C")</td>
                        <td>@h.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code
{
    private bool isWeatherLoading = false;
    private bool isAiLoading = false;
    private string query = string.Empty;
    private string error = string.Empty;
    private string location = string.Empty;
    private CoordinatesDto? coordinates;
    private ForecastDto? forecastDto;
    private RecommendationDto? recommendationDto;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        this.location = query.Trim();

        // Check if query is empty
        if (string.IsNullOrWhiteSpace(this.location))
        {
            this.error = "Bitte einen Ort eingeben.";
            return;
        }

        // Reset previous errors
        this.error = string.Empty;
        await InvokeAsync(StateHasChanged);

        // Get coordinates for the query
        this.isWeatherLoading = true;
        this.coordinates = await BackendService.GetGeocodeAsync(this.location);
        if (this.coordinates == null)
        {
            this.error = "Ort nicht gefunden.";
            return;
        }
        await InvokeAsync(StateHasChanged);

        // Get weather forecast for the coordinates
        this.forecastDto = await BackendService.GetWeatherForecastAsync(this.coordinates);
        if (this.forecastDto == null)
        {
            this.error = "Wetterdaten konnten nicht abgerufen werden.";
            return;
        }
        this.isWeatherLoading = false;
        await InvokeAsync(StateHasChanged);

        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Load AI recommendation if user is authenticated
        if (user.Identity?.IsAuthenticated == true)
        {
            this.isAiLoading = true;
            await InvokeAsync(StateHasChanged);
            var recommendationRequestDto = new RecommendationRequestDto { Location = this.location, HourlyForecast = this.forecastDto.Hourly };
            this.recommendationDto = await BackendService.GetAiRecommendationAsync(recommendationRequestDto);
            this.isAiLoading = false;
        }
    }
}
